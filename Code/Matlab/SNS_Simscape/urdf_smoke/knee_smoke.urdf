<?xml version="1.0"?>
<!-- Minimal two-link knee for validating the URDF->smimport pipeline
     (see sns_urdf_smoke.m). Stand-in for the real SW2URDF export of
     09_BA_003.SLDASM. -->
<robot name="knee_smoke">
  <link name="femur">
    <inertial>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.0270" iyy="0.0270" izz="0.0036" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.4"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.4"/></geometry>
    </collision>
  </link>
  <link name="tibia">
    <inertial>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.0163" iyy="0.0163" izz="0.0022" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.4"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.4"/></geometry>
    </collision>
  </link>
  <joint name="knee" type="revolute">
    <origin xyz="0 0 -0.4" rpy="0 0 0"/>
    <parent link="femur"/>
    <child link="tibia"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="0" effort="100" velocity="10"/>
  </joint>
</robot>
