"MN_hip_flx" [id="deng14:13",label="MN hip flx",shape=ellipse,style="filled",fillcolor="#F4C5B8"];
"RG_HC_ext" -> "RG_IN_ext" [id="deng14:edge:0",arrowhead=inv,label="2.75",style="solid",color="#222222"];
