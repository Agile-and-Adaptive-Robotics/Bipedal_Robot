digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.7", splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=16, labelloc=t, label="w2lvar | connection overview" ];
node [fontname="Arial", fontsize=12, margin="0.12,0.08", penwidth=1.2];
edge [fontname="Arial", fontsize=10, arrowsize=0.75, penwidth=1.1];
"Descending and commissural" [id="Descending and commissural",label="Descending and commissural\n26 neurons",shape=box,style="rounded,filled",fillcolor="#F3E5B5"];
