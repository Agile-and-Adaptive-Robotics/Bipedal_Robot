"Reflex INs" [id="Reflex INs",label="Reflex INs\n470 neurons",shape=box,style="rounded,filled",fillcolor="#F3E5B5"];
"Descending and commissural" -> "RG" [id="w2lvar:bundle:0",arrowhead=none,label="18 edges",style="solid",color="#555555"];
