"Descending and commissural" -> "MN" [id="w2lvar:bundle:5",arrowhead=none,label="18 edges",style="solid",color="#555555"];
"Afferents" -> "MN" [id="w2lvar:bundle:6",arrowhead=none,label="92 edges",style="solid",color="#555555"];
