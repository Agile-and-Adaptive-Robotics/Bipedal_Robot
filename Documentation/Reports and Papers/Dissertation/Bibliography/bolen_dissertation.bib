@article{sarosiCOMPARATIVESURVEYVARIOUS2017,
	title = {{COMPARATIVE} {SURVEY} {OF} {VARIOUS} {STATIC} {AND} {DYNAMIC} {MODELS} {OF} {PNEUMATIC} {ARTIFICIAL} {MUSCLES}},
	volume = {41},
	issn = {0315-8977},
	url = {http://www.nrcresearchpress.com/doi/10.1139/tcsme-2017-514},
	doi = {10.1139/tcsme-2017-514},
	abstract = {A lesser known type of pneumatic actuators is pneumatic artificial muscle (PAM) although these pneumatic actuators play an important role in industrial, medical and other applications. In this study a PAM model based on the assumption Euler’s law is developed, some static force models (geometric model-based static force model, static force model using maximum force of PAM and static force model using a polynomial function) are compared to Sárosi’s force model and two dynamic models based on Sárosi’s static force model and Hill’s muscle model are presented.},
	language = {en},
	number = {5},
	urldate = {2023-03-08},
	journal = {Transactions of the Canadian Society for Mechanical Engineering},
	author = {Sárosi, József and Piteľ, Ján and Tóthová, Mária and Hošovský, Alexander and Bíró, István},
	month = dec,
	year = {2017},
	pages = {825--844},
	annote = {Notes - JC
Category:


Sarosi surveyed the different static and dynamic models for BPA. 


The models were tested and compared on the same test setup. This is quite a good experiment to show the performance between models.


Context:


The paper distinguishes the different model approaches in geometry, force-based, and polynomial fitting. The polynomial function approach yields the best performance, but requires a fit of 20 parameters to find the governing equation. The model developed by the author is also polynomial but only requires 5 parameters and performs similarly to the polynomial approach. 


Interestingly, the dynamic model by the author can also model hysteresis, which is quite a dominant aspect of the muscle control. 


Correctness:


The models were applied to the same set up and measured presumably using the same muscle. It’s difficult to tell the performance change of the muscle as it’s used, i.e. there could have been changes to the muscle characteristics. 


Contributions:


This is a very nice summary of the different muscle models. 


Clarity:


The paper is easy to understand. Some model description was vague, but the original contest is still in the reference. 


},
	file = {Sárosi et al. - 2017 - COMPARATIVE SURVEY OF VARIOUS STATIC AND DYNAMIC M.pdf:C\:\\Users\\Ben Bolen\\Zotero\\storage\\WWGMLBSM\\Sárosi et al. - 2017 - COMPARATIVE SURVEY OF VARIOUS STATIC AND DYNAMIC M.pdf:application/pdf},
}

@article{maddenArtificialMuscleTechnology2004,
	title = {Artificial muscle technology: physical principles and naval prospects},
	volume = {29},
	issn = {1558-1691},
	shorttitle = {Artificial muscle technology},
	doi = {10.1109/JOE.2004.833135},
	abstract = {The increasing understanding of the advantages offered by fish and insect-like locomotion is creating a demand for muscle-like materials capable of mimicking nature's mechanisms. Actuator materials that employ voltage, field, light, or temperature driven dimensional changes to produce forces and displacements are suggesting new approaches to propulsion and maneuverability. Fundamental properties of these new materials are presented, and examples of potential undersea applications are examined in order to assist those involved in device design and in actuator research to evaluate the current status and the developing potential of these artificial muscle technologies. Technologies described are based on newly explored materials developed over the past decade, and also on older materials whose properties are not widely known. The materials are dielectric elastomers, ferroelectric polymers, liquid crystal elastomers, thermal and ferroelectric shape memory alloys, ionic polymer/metal composites, conducting polymers, and carbon nanotubes. Relative merits and challenges associated with the artificial muscle technologies are elucidated in two case studies. A summary table provides a quick guide to all technologies that are discussed.},
	number = {3},
	journal = {IEEE Journal of Oceanic Engineering},
	author = {Madden, J.D.W. and Vandesteeg, N.A. and Anquetil, P.A. and Madden, P.G.A. and Takshi, A. and Pytel, R.Z. and Lafontaine, S.R. and Wieringa, P.A. and Hunter, I.W.},
	month = jul,
