@article{martensModelingStaticForce2017a,
	title = {Modeling the {Static} {Force} of a {Festo} {Pneumatic} {Muscle} {Actuator}: {A} {New} {Approach} and a {Comparison} to {Existing} {Models}},
	volume = {6},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
