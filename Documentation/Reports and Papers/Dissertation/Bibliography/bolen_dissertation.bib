	month = nov,
	year = {2017},
	keywords = {pneumatic artificial muscle (PAM), pneumatic muscle actuator (PMA), pneumatic robot, pneumatic system},
	pages = {33},
	annote = {
Another paper attempting to define the dynamics of Festo BPAs.
},
