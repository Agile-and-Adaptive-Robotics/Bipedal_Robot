@article{chenRealizingHumanlikeManipulation2019,
	title = {Realizing human-like manipulation with a musculoskeletal system and biologically inspired control scheme},
	volume = {339},
	issn = {0925-2312},
	url = {https://www.sciencedirect.com/science/article/pii/S0925231218315315},
	doi = {10.1016/j.neucom.2018.12.069},
	abstract = {Human can accomplish manipulation with high precision, flexibility and robustness. As a musculoskeletal system naturally possesses superiorities of flexibility and robustness, realizing human-like manipulation with the musculoskeletal system is investigated in this paper. However, the redundancy, coupling and strong nonlinearity of musculoskeletal system will bring many challenges for control. Therefore, based on strategies of human manipulation and muscle coordination, a biologically inspired control scheme is proposed. First, we apply a strategy based on attractive region in environment to plan the manipulation under environmental constraints in the task space. Then, we extract muscle synergies as movement primitives and design an iterative learning controller to coordinate these synergies to accomplish complex manipulation. The muscle synergy based iterative learning controller can overcome the difficulty of constructing an explicit model of the sophisticated musculoskeletal system and improve motion learning by transforming the high dimensional muscle excitation into a lower dimensional space. With the combination of strategy based on attractive region in environment and muscle synergy based controller, we preliminarily realize human-like manipulation with high precision, flexibility and robustness. The effectiveness of our control scheme is verified in a peg-in-hole assembly task.},
	language = {en},
	urldate = {2021-02-10},
	journal = {Neurocomputing},
	author = {Chen, Jiahao and Zhong, Shanlin and Kang, Erlong and Qiao, Hong},
	month = apr,
	year = {2019},
	keywords = {Attractive region in environment, Biologically inspired, Human-like manipulation, Muscle synergy, Musculoskeletal system},
	pages = {116--129},
	file = {Chen et al. - 2019 - Realizing human-like manipulation with a musculosk.pdf:C\:\\Users\\Ben Bolen\\Zotero\\storage\\VG8QYDDW\\Chen et al. - 2019 - Realizing human-like manipulation with a musculosk.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\Ben Bolen\\Zotero\\storage\\Z2LDUSBI\\S0925231218315315.html:text/html},
}

