\contentsline {table}{\numberline {2.1}{\ignorespaces Coefficients of the \qty {10}{\mm } Festo BPA pressure model of Equation~(\ref {eq:BPAFit}), corrected from \citet {hunt_modeling_2017}.}}{19}{table.caption.7}%
