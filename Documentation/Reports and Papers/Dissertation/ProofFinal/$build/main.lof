\contentsline {figure}{\numberline {4.4}{\ignorespaces Bracket-frame construction from attachment point $\mathbf {p}_A$ or $\mathbf {p}_B$: yaw about fixed $\hat {\mathbf z}_s$ aligns the sagittal projection (A); pitch about current $\hat {\mathbf y}_{br}$ aligns the full point vector (B).}}{76}{figure.caption.28}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Projection of bracket displacement onto the actuator force path. Each bracket has a local basis $\hat {\mathbf e}^{(j)}_1$, $\hat {\mathbf e}^{(j)}_2$, and $\hat {\mathbf e}^{(j)}_3$. The displacement $\bm {\eta }_{br,j}$ has an axial projection $\delta _{br,j}$ along $\hat {\mathbf u}_j$; the two bracket projections and tendon elongation contribute to the change in actuator length. Displacements are exaggerated.}}{81}{figure.caption.29}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces BPA crossing a flexed knee}}{84}{figure.caption.30}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Pinned-knee flexor torque before design-parameter optimization: \textbf {(A)} $l_0=\qty {48.5}{\cm }$, \textbf {(B)} $l_0=\qty {41.0}{\cm }$, \textbf {(C)} $l_0=\qty {45.7}{\cm }$, and \textbf {(D)} $l_0=\qty {40.6}{\cm }$ with a \qty {35}{\mm } tendon. Panels \textbf {(A)} and \textbf {(B)} are training tests; \textbf {(C)} and \textbf {(D)} are validation tests. The legend distinguishes measurements, the Hunt model, the improved BPA model, and the hybrid calculation.}}{95}{figure.caption.35}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Optimized pinned-knee flexor torque: \textbf {(A)} $l_0=\qty {48.5}{\cm }$, \textbf {(B)} $l_0=\qty {41.0}{\cm }$, \textbf {(C)} $l_0=\qty {45.7}{\cm }$, and \textbf {(D)} $l_0=\qty {40.6}{\cm }$ with a \qty {35}{\mm } tendon. Panels \textbf {(A)} and \textbf {(B)} are training tests; \textbf {(C)} and \textbf {(D)} are validation tests. Circles show measurements, dashed curves the improved BPA model, and solid magenta curves the optimized model.}}{97}{figure.caption.37}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Optimized pinned-knee extensor torque: \textbf {(A)} $l_0=\qty {43.6}{\cm }$, \textbf {(B)} $l_0=\qty {43.2}{\cm }$ with a \qty {22}{\mm } tendon, \textbf {(C)} $l_0=\qty {45.7}{\cm }$, \textbf {(D)} $l_0=\qty {40.0}{\cm }$, \textbf {(E)} $l_0=\qty {40.0}{\cm }$ with a \qty {40}{\mm } tendon, and \textbf {(F)} $l_0=\qty {46.5}{\cm }$. Panels \textbf {(A)}--\textbf {(C)} are training tests; \textbf {(D)}--\textbf {(F)} are validation tests. The legend applies to all panels.}}{100}{figure.caption.39}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Biomimetic-knee extensor test: \textbf {(A)} apparatus with the BPA passing between the femoral condyles; \textbf {(B)} measured torque, the improved BPA baseline, the optimized model at the adopted terms, and the approximate hybrid calculation for the \qty {10}{\mm }-diameter, \qty {51.8}{\cm } BPA.}}{103}{figure.caption.41}%
