<?xml version="1.0" encoding="UTF-8"?>
<OpenSimDocument Version="40500">
  <!--
    Static-optimization backsolve for Tutorial1/normal.mot.

    IMPORTANT: normal.mot contains prescribed coordinates only. No matching
    GRF/COP file exists in Tutorial1, so this setup deliberately applies no
    external loads. Results are therefore a kinematics-only muscle solution,
    not a dynamically consistent loaded-walking estimate. Residual/infeasible
    frames must be reported rather than hidden.
  -->
  <AnalyzeTool name="normal_backsolve">
    <model_file> gait2392_simbody_normal_so.osim </model_file>
    <replace_force_set> false </replace_force_set>
    <force_set_files> normal_pelvis_residuals.xml </force_set_files>
    <results_directory> ./ResultsNormalSO </results_directory>
    <output_precision> 10 </output_precision>
    <initial_time> 0.000000 </initial_time>
    <final_time> 1.000000 </final_time>
    <solve_for_equilibrium_for_auxiliary_states> false </solve_for_equilibrium_for_auxiliary_states>
    <maximum_number_of_integrator_steps> 20000 </maximum_number_of_integrator_steps>
    <maximum_integrator_step_size> 1.0 </maximum_integrator_step_size>
    <minimum_integrator_step_size> 1e-08 </minimum_integrator_step_size>
    <integrator_error_tolerance> 1e-10 </integrator_error_tolerance>
    <AnalysisSet name="Analyses">
      <objects>
        <StaticOptimization name="StaticOptimization">
          <on> true </on>
          <start_time> 0.000000 </start_time>
          <end_time> 1.000000 </end_time>
          <step_interval> 1 </step_interval>
          <in_degrees> true </in_degrees>
          <use_model_force_dof_velocity> false </use_model_force_dof_velocity>
          <activation_exponent> 2 </activation_exponent>
          <!--
            gait2392_simbody.osim cannot equilibrate lat_gas_r at this pose
            (NaN fiber length in OpenSim 4.6).  Disable FLV physiology so the
            solve uses moment arms and maximum isometric forces without
            pretending the invalid fiber equilibrium succeeded.
          -->
          <use_muscle_physiology> false </use_muscle_physiology>
        </StaticOptimization>
      </objects>
      <groups/>
    </AnalysisSet>
    <ControllerSet name="Controllers"><objects/><groups/></ControllerSet>
    <external_loads_file> </external_loads_file>
    <states_file> </states_file>
    <coordinates_file> Tutorial1/normal.mot </coordinates_file>
    <speeds_file> </speeds_file>
    <lowpass_cutoff_frequency_for_coordinates> 6 </lowpass_cutoff_frequency_for_coordinates>
  </AnalyzeTool>
</OpenSimDocument>
